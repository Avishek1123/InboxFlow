# Copy to .env when using Docker Compose:
#   cp .env.docker.example .env

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provided by docker-compose — override only if needed
DATABASE_URL=postgresql://inboxflow:inboxflow@postgres:5432/inboxflow?schema=public
REDIS_URL=redis://redis:6379

CRON_SECRET=local-cron-secret-change-me
TOKEN_ENCRYPTION_KEY=

# Firebase — https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI (at least one)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
AI_PROVIDER_PRIORITY=groq,gemini,openrouter

# Google / WhatsApp / other keys — see .env.example
