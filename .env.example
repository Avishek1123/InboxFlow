# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Firebase Authentication ───────────────────────────────────────────────────
# Firebase Console → Project settings → Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Token encryption (32-byte key, base64) ──────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ─── Google OAuth / Gmail API ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console redirect URI
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail/callback
# Space-separated Gmail scopes
GOOGLE_GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/userinfo.email"

# ─── Gmail sync worker ─────────────────────────────────────────────────────────
# Cron secret for Vercel cron / manual trigger
CRON_SECRET=
# Minutes between syncs per account (BullMQ / cron)
GMAIL_SYNC_INTERVAL_MINUTES=5
GMAIL_SYNC_BATCH_SIZE=50
GMAIL_SYNC_LOCK_TTL_MINUTES=15

# ─── Attachment storage (Vercel Blob) ──────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Redis (BullMQ job queue) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or standard Redis URL for BullMQ
REDIS_URL=

# ─── Trigger.dev (optional scheduler) ──────────────────────────────────────────
TRIGGER_SECRET_KEY=

# ─── Meta / WhatsApp Business Cloud API ────────────────────────────────────────
# Meta App Dashboard → App ID & App Secret
META_APP_ID=
META_APP_SECRET=
# Permanent System User or long-lived token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=
# Phone number ID from WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Webhook verify token (you define this; must match Meta webhook config)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=
# Public webhook URL (Meta must reach this)
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/whatsapp
# Graph API version
WHATSAPP_GRAPH_API_VERSION=v21.0
# Outbound send retry
WHATSAPP_SEND_MAX_RETRIES=5
WHATSAPP_SEND_RETRY_BASE_MS=1000
# Webhook processing retry
WHATSAPP_WEBHOOK_MAX_RETRIES=5
WHATSAPP_WEBHOOK_RETRY_BASE_MS=2000

# ─── AI providers (free tiers — set at least one) ───────────────────────────────
# Groq: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
# Provider fallback order (cost-optimized: fast free models first)
AI_PROVIDER_PRIORITY=groq,gemini,openrouter
AI_MAX_INPUT_CHARS=12000
AI_REQUEST_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_ORG_PER_MINUTE=30
AI_CACHE_TTL_SECONDS=3600
AI_MAX_RETRIES_PER_PROVIDER=2
